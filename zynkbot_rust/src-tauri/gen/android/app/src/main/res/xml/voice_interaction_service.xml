<?xml version="1.0" encoding="utf-8"?>
<!-- Declares Zynkbot as a candidate digital assistant. Referenced from the
     ZynkAssistantService <meta-data> in AndroidManifest.xml.
     recognitionService is REQUIRED: the framework's VoiceInteractionServiceInfo
     parser treats its absence as a parse error, which makes the role controller
     reject the app ("unqualified voice interaction service"). Zynkbot does its
     own recognition with Vosk, so the referenced service is a minimal stub.
     supportsLaunchVoiceAssistFromKeyguard lets the session be invoked from the
     lock screen, which is the whole point of the hands-free flow. -->
<voice-interaction-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:sessionService="ai.containai.zynkbot.ZynkAssistantSessionService"
    android:recognitionService="ai.containai.zynkbot.ZynkRecognitionService"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true" />
